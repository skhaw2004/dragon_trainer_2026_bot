# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real values.

# From @BotFather on Telegram: /newbot, then copy the token it gives you.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwn

# Comma-separated Telegram *user* IDs (numbers, not @handles) for whoever runs
# the game. Message @userinfobot on Telegram to find your own ID.
# These accounts can use the admin commands AND receive every /report, which
# reveals the real sender of a flagged message. Leave this empty and nobody is
# an admin — every admin command will silently do nothing.
ADMIN_IDS=123456789

# --- everything below is optional ---

# Where game.db is written. Leave unset locally. In production this MUST point
# at persistent storage, or the database is wiped on every restart and all
# participants lose their claim.
# DB_DIR=/var/data

# Path to the signup export. Defaults to signups.csv next to the code.
# SIGNUPS_FILE=signups.csv

# Set to any string to make the random matching reproducible. Unset = random.
# MATCH_SEED=

# Seconds a chat connection survives inactivity before auto-disconnecting.
# Defaults to 900 (15 minutes).
# IDLE_SECONDS=900
